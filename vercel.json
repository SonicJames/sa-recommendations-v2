{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cookie",
      "destination": "/?flow=cookie",
      "permanent": false
    },
    {
      "source": "/no-cookie",
      "destination": "/?flow=no-cookie",
      "permanent": false
    }
  ]
}
